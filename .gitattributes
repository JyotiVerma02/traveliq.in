# Force LF line endings for all text files in the repo.
# This prevents CRLF vs LF hydration mismatches between server and client
# builds when developing on Windows and deploying to Linux (Vercel).

* text=auto eol=lf

# Explicitly enforce LF for source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.mts  text eol=lf
*.xml  text eol=lf

# Binary files — never convert
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.avif binary
*.ico  binary
*.mp4  binary
*.woff binary
*.woff2 binary
